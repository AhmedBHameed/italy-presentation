{
  "name": "discover-italy",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive learning site built from Italy.pdf — clickable map, landmark galleries and a quiz.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "docker:build": "docker build -t discover-italy .",
    "docker:run": "docker run --rm -p 3000:3000 --name discover-italy discover-italy"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "express": "^4.19.2",
    "topojson-client": "^3.1.0"
  }
}
